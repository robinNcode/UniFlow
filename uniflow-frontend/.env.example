# UniFlow Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Merit list polling interval (milliseconds) — how often the live merit list refetches
VITE_MERIT_LIST_POLL_INTERVAL_MS=12000

# Payment status polling interval (milliseconds)
VITE_PAYMENT_POLL_INTERVAL_MS=3000

# Maximum duration to poll payment status before prompting user (milliseconds)
VITE_PAYMENT_POLL_TIMEOUT_MS=300000

# Seconds before reservation expiry at which UI shows urgent warning styling
VITE_RESERVATION_WARNING_THRESHOLD_SECONDS=120
